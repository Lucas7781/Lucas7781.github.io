# Container/bare-run port. docker-compose.yml maps host -> container :3001
# and Caddy targets :3001 over caddy-net — keep this at 3001 when running
# via Docker, or the deployed API silently dies.
PORT=3001
# Docker host binding for the backend container. Keep loopback — public
# traffic goes through Caddy. Change the port here, not the exposure.
BACKEND_HOST_PORT=127.0.0.1:8080
SENDER=your-hotmail-address@outlook.com
PASSWORD=your-hotmail-app-password
RECIPIENT=where-messages-should-arrive@example.com
